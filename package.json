{
  "name": "vscoderpc",
  "displayName": "VS Code RPC",
  "description": "%vscoderpc.description%",
  "version": "1.3.6",
  "publisher": "theuplauncher",
  "repository": {
    "url": "https://github.com/uplauncher/vscoderpc"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "l10n": "./l10n",
  "keywords": [
    "discord",
    "discord rpc",
    "discord rich presence",
    "rich presence",
    "rpc",
    "vscode rpc"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "pricing": "Free",
  "sponsor": {
    "url": "https://github.com/sponsors/raidesuuu"
  },
  "icon": "icon.png",
  "main": "dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "VS Code RPC",
      "properties": {
        "vscoderpc.enabled": {
          "type": "boolean",
          "default": false,
          "title": "%vscoderpc.enableTitle%",
          "description": "%vscoderpc.enableDescription%"
        },
        "vscoderpc.privateMode": {
          "type": "boolean",
          "default": false,
          "title": "%vscoderpc.privateModeTitle%",
          "description": "%vscoderpc.privatemodeDescription%"
        },
        "vscoderpc.clientId": {
          "type": "string",
          "default": "1147502929687875614",
          "title": "%vscoderpc.clientIdTitle%",
          "description": "%vscoderpc.clientIdDescription%"
        }
      }
    },
    "commands": [
      {
        "command": "vscoderpc.startrpc",
        "title": "%vscoderpc.startrpc%"
      },
      {
        "command": "vscoderpc.stoprpc",
        "title": "%vscoderpc.stoprpc%"
      },
      {
        "command": "vscoderpc.reconnectrpc",
        "title": "%vscoderpc.reconnectrpc%"
      },
      {
        "command": "vscoderpc.toggleprivate",
        "title": "%vscoderpc.toggleprivate%"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/clipboardy": "^2.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "~22.10.2",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "bufferutil": "^4.0.8",
    "eslint": "^9.17.0",
    "ts-loader": "^9.5.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "utf-8-validate": "^6.0.5",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.2.0",
    "axios": "^1.7.9",
    "clipboardy": "^4.0.0",
    "discord-api-types": "^0.37.111"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}